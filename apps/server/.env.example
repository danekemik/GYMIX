# Пример окружения сервера Gymix. Скопируйте в apps/server/.env и подставьте значения.
# Обязательные для production: DATABASE_URL, JWT_SECRET, APP_ORIGINS, EMAIL_MODE=smtp.

# --- Основное ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://gymix:gymix@localhost:55432/gymix

# CORS: список разрешённых источников клиента через запятую.
APP_ORIGINS=http://localhost:5173

# Доверять X-Forwarded-For (только за доверенным прокси/балансировщиком).
TRUST_PROXY=false

# --- Миграции и посев референсных данных -----------------------------------
# Каталог с файлами drizzle (packages/db/drizzle) и reference/.
MIGRATIONS_DIR=../../packages/db/drizzle
REFERENCE_DIR=../../reference
APP_MIGRATE=true
APP_SEED=true

# --- Сессии и токены --------------------------------------------------------
# Минимум 32 символа. Сгенерируйте: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-in-production-0000
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30

# --- Почта ------------------------------------------------------------------
# console — коды пишутся в лог (dev); smtp — настоящая отправка.
EMAIL_MODE=console
MAIL_FROM=Gymix <no-reply@gymix.app>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Фоновая очистка --------------------------------------------------------
JOB_INTERVAL_MS=60000
