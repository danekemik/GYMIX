{
  "name": "gymix",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "e2e": "playwright test",
    "e2e:typecheck": "tsc -p tsconfig.e2e.json --noEmit",
    "check": "pnpm typecheck && pnpm e2e:typecheck && pnpm test && python3 scripts/verify_sync.py",
    "sync:check": "python3 scripts/verify_sync.py",
    "server:dev": "pnpm --filter @gymix/server dev",
    "server:build": "pnpm --filter @gymix/server build",
    "server:start": "pnpm --filter @gymix/server start",
    "migrations:generate": "pnpm --filter @gymix/db migrations:generate",
    "build": "turbo build",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:stop": "docker compose -f docker-compose.dev.yml stop",
    "db:prepare": "pnpm --filter @gymix/server db:prepare"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
