{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    "reference/*.md",
    "packages/db/drizzle/**"
  ],
  "concurrency": "4",
  "tasks": {
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "build": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": [
        "dist/**"
      ]
    }
  }
}
